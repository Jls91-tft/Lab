# =============================================================
# Cepa Cero — .gitignore
# El proyecto Unity vive en una subcarpeta (p. ej. CepaCero/), por eso
# los patrones de Unity NO van anclados a la raíz: valen en cualquier nivel.
# =============================================================

# ---------- Unity (generado por el editor; se regenera solo) ----------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset Store / herramientas que generan archivos en Assets
**/[Aa]ssets/[Aa]ssetStoreTools*
**/[Aa]ssets/[Ss]treamingAssets/aa/
**/[Aa]ssets/Plugins/Editor/JetBrains*

# Metas de carpetas/archivos ignorados (evita metas huérfanos)
[Ll]ibrary.meta
[Tt]emp.meta
[Oo]bj.meta
[Bb]uild.meta
[Bb]uilds.meta
[Ll]ogs.meta
[Uu]ser[Ss]ettings.meta
[Mm]emoryCaptures.meta

# Proyectos de IDE generados por Unity
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports y builds
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# Unity Cloud / servicios (credenciales locales)
**/[Aa]ssets/[Pp]lugins/[Ee]ditor/[Uu]nity[Cc]onnect*

# Steamworks: el AppID local de pruebas no se versiona
steam_appid.txt

# ---------- Python (tools/) ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Salidas y cachés de osm2tiles (se regeneran). Las salidas "oficiales"
# que lea Unity se copiarán a la carpeta del proyecto Unity.
tools/osm2tiles/out/
tools/osm2tiles/cache/

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Claude Code (ajustes locales, no compartidos) ----------
.claude/settings.local.json

# ---------- dotnet (tests/ y tools/ fuera de Unity) ----------
[Bb]in/
# Los .csproj de Unity se regeneran, pero los de tests/ y tools/ son nuestros
!tests/**/*.csproj
!tools/**/*.csproj
